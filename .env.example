# Copy this file to .env and fill in the values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# ---------- Backend only (secret) ----------
# Your OpenAI API key. Only the backend container receives it.
OPENAI_API_KEY=
# Any OpenAI model that supports Structured Outputs, e.g. gpt-5-mini.
OPENAI_MODEL=gpt-5-mini
# Optional: USD price per 1M tokens for OPENAI_MODEL (see openai.com/api/pricing).
# Leave blank to store estimated_cost as NULL.
OPENAI_INPUT_PRICE_PER_1M_TOKENS=
OPENAI_OUTPUT_PRICE_PER_1M_TOKENS=

# ---------- Database (used by the db and backend containers) ----------
# docker-compose.yml builds DATABASE_URL for the backend from these values.
POSTGRES_USER=apprendre
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=apprendre

# ---------- Backend (not secret) ----------
# Comma-separated list of browser origins allowed to call the API.
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---------- Frontend (PUBLIC: visible to anyone using the site) ----------
# Where the *browser* sends API requests. Never put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
